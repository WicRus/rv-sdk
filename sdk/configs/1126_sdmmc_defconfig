# cpu
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABIHF=y

BR2_CCACHE=y

# prebuild external toolchain
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_RV_SDK_PATH)/prebuilts/gcc/linux-x86/arm/gcc-arm-8.3-2019.03-x86_64-arm-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_GCC_8=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_19=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# SRC OVERIDES
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_RV_SDK_PATH)/overrides/1126.mk"

# KERNEL
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RV_SDK_PATH)/boards/1126/kernel_1126_defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_RV_SDK_PATH)/boards/1126/dts"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="br-ext_1126_sdmmc_minimal"
BR2_LINUX_KERNEL_APPENDED_DTB=y

# U-BOOT
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_USE_CUSTOM_CONFIG=y
BR2_TARGET_UBOOT_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RV_SDK_PATH)/boards/1126/u-boot_1126.config"
BR2_TARGET_UBOOT_FORMAT_DTB=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-nodtb.bin"
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_RV_SDK_PATH)/boards/1126/u-boot_1126.dts"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="DEVICE_TREE=u-boot_1126"

BR2_PACKAGE_ROCKCHIP_RKBIN=y
BR2_PACKAGE_ROCKCHIP_RKBIN_TEE_FILENAME="bin/rv11/rv1126_tee_ta_v2.15.bin"
BR2_PACKAGE_ROCKCHIP_RKBIN_TPL_FILENAME="bin/rv11/rv1126_ddr_924MHz_v1.13.bin"

# HOOK SCRIPTS

# BR2_ROOTFS_PRE_BUILD_SCRIPT
# string "Custom scripts to run before commencing the build"
# BR2_ROOTFS_PRE_BUILD_SCRIPT_ARGS

# BR2_ROOTFS_POST_BUILD_SCRIPT
# string "Custom scripts to run before creating filesystem images"
# BR2_ROOTFS_POST_BUILD_SCRIPT_ARGS

# BR2_ROOTFS_POST_FAKEROOT_SCRIPT
# string "Custom scripts to run inside the fakeroot environment"
# BR2_ROOTFS_POST_FAKEROOT_SCRIPT_ARGS

BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RV_SDK_PATH)/boards/1126/post-image_1126_sdmmc.sh"
# string "Custom scripts to run after creating filesystem images"
# BR2_ROOTFS_POST_IMAGE_SCRIPT_ARGS

# system
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RV_SDK_PATH)/boards/1126/busybox.fragment"

BR2_ENABLE_LOCALE_WHITELIST="C en_US"
BR2_GENERATE_LOCALE="en_US"

BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Etc/GMT+12"

BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyFIQ0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_TARGET_GENERIC_HOSTNAME="xos"
BR2_TARGET_GENERIC_ISSUE="Welcome to xos"
BR2_TARGET_GENERIC_ROOT_PASSWD="123"
BR2_SYSTEM_DHCP="eth0"

# Filesystems
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="250M"
# BR2_TARGET_ROOTFS_TAR is not set

# post-image_1126_sdmmc.sh deps
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SIGNATURE_SUPPORT=y
