# cpu
BR2_arm=y
BR2_cortex_a7=y

BR2_CCACHE=y

BR2_TOOLCHAIN_BUILDROOT_CXX=y

BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_PACKAGE_BUSYBOX is not set

# SRC OVERIDES
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_RV_SDK_PATH)/overrides/1106.mk"

# KERNEL
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.10.160"
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RV_SDK_PATH)/boards/1106/kernel_1106_defconfig"
# KERNEL HEADERS
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_10=y

